{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "40"
  },
  "model": "claude-opus-5-5",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agent-hooks.cjs session-start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "builder|specialist",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agent-hooks.cjs verify",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "ponytail@ponytail": true
  }
}
